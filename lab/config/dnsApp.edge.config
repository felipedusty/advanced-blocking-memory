{
  "enableBlocking": true,
  "blockingAnswerTtl": 300,
  "blockListUrlUpdateIntervalHours": 24,
  "blockListUrlUpdateIntervalMinutes": 0,
  "localEndPointGroupMap": {
    "127.0.0.1": "edge"
  },
  "networkGroupMap": {
    "127.0.0.1": "edge",
    "0.0.0.0/0": "edge",
    "::1": "edge",
    "[::]/0": "edge"
  },
  "groups": [
    {
      "name": "edge",
      "enableBlocking": true,
      "allowTxtBlockingReport": true,
      "blockAsNxDomain": true,
      "blockingAddresses": [
        "0.0.0.0",
        "::"
      ],
      "allowed": [
        "edge-static-allowed.example.com"
      ],
      "blocked": [
        "edge-static.example.com"
      ],
      "allowListUrls": [
        "file:///etc/dns/edge/allow-domains.txt"
      ],
      "blockListUrls": [
        "file:///etc/dns/edge/block-hosts.txt",
        "file:///etc/dns/edge/dense-short.txt"
      ],
      "allowedRegex": [],
      "blockedRegex": [],
      "regexAllowListUrls": [],
      "regexBlockListUrls": [
        "file:///etc/dns/edge/regex.txt"
      ],
      "adblockListUrls": [
        "file:///etc/dns/edge/adblock.txt"
      ]
    }
  ]
}
