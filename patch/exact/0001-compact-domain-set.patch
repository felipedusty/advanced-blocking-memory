+                Span<byte> value = stackalloc byte[255];
+                if (!Encoding.UTF8.TryGetBytes(domain, value, out int valueLength))
+                    return false; //invalid domain name
+
+                ReadOnlySpan<byte> valueSpan = value.Slice(0, valueLength);
+
+                if ((_filter is not null) && !MayContain(valueSpan))
