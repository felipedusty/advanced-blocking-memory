+
+                    if (result < 0)
+                        low = mid + 1;
+                    else
+                        high = mid - 1;
+                }
+
+                return false;
+            }
+
+            #endregion
+
+            #region properties
+
+            public int RawCount
+            { get { return _count; } }
+
+            #endregion
+        }
