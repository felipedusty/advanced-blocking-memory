+        //exact set of domains as the parser stores them (the plain block list lowercases; the
+        //adblock parser does not). Add() only before Sort(); Contains() only after. Names over
+        //255 characters or 255 UTF-8 bytes are not stored: both parsers reject them through
+        //IsDomainNameValid, so no entry is lost.
+        sealed class DomainSet
+        {
+            #region variables
+
+            const int FilterHashCount = 7;
+
+            byte[] _buffer;
+            int _length;
+            int[] _offsets;
+            int _count;
+            int _sortedCount;
+            bool _sorted;
+            ulong[]? _filter;
+            int _filterMask;
+
+            #endregion
+
+            #region constructor
+
+            public DomainSet(int capacity)
+            {
+                if (capacity < 1024)
+                    capacity = 1024;
+
+                _buffer = new byte[capacity];
+                _offsets = new int[Math.Max(16, capacity / 16)];
+            }
+
+            #endregion
+
+            #region private
+
+            private int CompareEntry(int a, int b)
+            {
+                return _buffer.AsSpan(a + 1, _buffer[a]).SequenceCompareTo(_buffer.AsSpan(b + 1, _buffer[b]));
+            }
+
+            private int CompareEntryToSpan(int a, ReadOnlySpan<byte> value)
+            {
+                return _buffer.AsSpan(a + 1, _buffer[a]).SequenceCompareTo(value);
+            }
+
+            private static (uint h1, uint h2) GetFilterHashes(ReadOnlySpan<byte> value)
+            {
+                uint h1 = 2166136261u;
+                uint h2 = 0x9e3779b9u;
+
+                foreach (byte b in value)
+                {
+                    h1 = (h1 ^ b) * 16777619u;
+                    h2 = (h2 ^ b) * 2246822519u;
+                }
+
+                return (h1, h2 | 1);
+            }
+
+            private void AddToFilter(ReadOnlySpan<byte> value)
+            {
+                (uint h1, uint h2) = GetFilterHashes(value);
+
+                for (int i = 0; i < FilterHashCount; i++)
+                {
+                    uint bit = (h1 + ((uint)i * h2)) & (uint)_filterMask;
+                    _filter![bit >> 6] |= 1UL << (int)(bit & 63);
+                }
+            }
+
+            private bool MayContain(ReadOnlySpan<byte> value)
+            {
+                (uint h1, uint h2) = GetFilterHashes(value);
+
+                for (int i = 0; i < FilterHashCount; i++)
+                {
+                    uint bit = (h1 + ((uint)i * h2)) & (uint)_filterMask;
+
+                    if ((_filter![bit >> 6] & (1UL << (int)(bit & 63))) == 0)
+                        return false;
+                }
+
+                return true;
+            }
+
+            #endregion
+
+            #region public
+
+            public void Add(string domain)
+            {
+                if (_sorted)
+                    throw new InvalidOperationException("Add() must be called before Sort().");
+
+                if (domain.Length > 255)
+                    return; //invalid domain name
+
+                Span<byte> value = stackalloc byte[255];
+                if (!Encoding.UTF8.TryGetBytes(domain, value, out int valueLength))
+                    return; //invalid domain name
+
+                if (_length + valueLength + 1 > _buffer.Length)
+                    Array.Resize(ref _buffer, Math.Max(_buffer.Length * 2, _length + valueLength + 1));
+
+                if (_count == _offsets.Length)
+                    Array.Resize(ref _offsets, _offsets.Length * 2);
+
+                _buffer[_length] = (byte)valueLength;
+                value.Slice(0, valueLength).CopyTo(_buffer.AsSpan(_length + 1));
+                _offsets[_count++] = _length;
+                _length += valueLength + 1;
+            }
+
+            public void Sort()
+            {
+                Array.Sort(_offsets, 0, _count, Comparer<int>.Create(CompareEntry));
+
+                //compact duplicates in place; RawCount stays the parser's raw count.
+                int uniqueCount = 0;
+                for (int i = 0; i < _count; i++)
+                {
+                    if ((uniqueCount == 0) || (CompareEntry(_offsets[i], _offsets[uniqueCount - 1]) != 0))
+                        _offsets[uniqueCount++] = _offsets[i];
+                }
