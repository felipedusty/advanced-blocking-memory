+        //exact set of domain names that does not keep one string object per name. The names (ASCII: the parsers only
+        //accept valid domain names) are stored in one array as a length byte followed by the name, in the order they are
+        //added. Seal() builds an array with the offset of every name grouped by hash bucket and the start of every bucket
+        //in a second array, so Contains() compares about 4 short names. The names are not copied at Seal().
+        //Add() is only for building; call Seal() before Contains().
+        sealed class DomainSet
+        {
+            #region variables
+
+            byte[] _names = new byte[1024];
+            int[] _bucketStarts = [0, 0];
+            int[] _offsets = [];
+            int _length;
+            int _count;
+
+            #endregion
+
+            #region private
+
+            private static int GetBucket(ReadOnlySpan<byte> name, int buckets)
+            {
+                HashCode hash = new HashCode();
+                hash.AddBytes(name);
+
+                return (int)(((ulong)(uint)hash.ToHashCode() * (uint)buckets) >> 32);
+            }
+
+            #endregion
+
+            #region public
+
+            public void EnsureCapacity(int capacity)
+            {
+                if (capacity > _names.Length)
+                    Array.Resize(ref _names, capacity);
+            }
+
+            public void Add(string domain)
+            {
+                if (_length + domain.Length + 1 > _names.Length)
+                    Array.Resize(ref _names, Math.Max(_names.Length * 2, _length + domain.Length + 1));
+
+                _names[_length] = (byte)domain.Length;
+                Encoding.ASCII.GetBytes(domain, _names.AsSpan(_length + 1));
+                _length += domain.Length + 1;
+                _count++;
+            }
+
+            public void Seal()
+            {
+                int buckets = Math.Max(1, _count / 4);
+                int[] starts = new int[buckets + 1];
+                _bucketStarts = starts;
+
+                //count the names of every bucket, then turn the counts into bucket ends
+                for (int i = 0; i < _length; i += _names[i] + 1)
+                    starts[GetBucket(_names.AsSpan(i + 1, _names[i]), buckets)]++;
+
+                for (int b = 1; b < buckets; b++)
+                    starts[b] += starts[b - 1];
+
+                starts[buckets] = starts[buckets - 1];
+
+                //fill every bucket from its end, which turns the ends into bucket starts
+                int[] offsets = new int[_count];
+
+                for (int i = 0; i < _length; i += _names[i] + 1)
+                    offsets[--starts[GetBucket(_names.AsSpan(i + 1, _names[i]), buckets)]] = i;
+
+                _offsets = offsets;
+            }
+
+            public bool Contains(string domain)
+            {
+                if (domain.Length > 255)
+                    return false; //invalid domain name
+
+                //a character outside ASCII becomes '?', which is not in any stored name
+                Span<byte> name = stackalloc byte[255];
+                name = name.Slice(0, Encoding.ASCII.GetBytes(domain, name));
+
+                int bucket = GetBucket(name, _bucketStarts.Length - 1);
+                int end = _bucketStarts[bucket + 1];
+
+                for (int k = _bucketStarts[bucket]; k < end; k++)
+                {
+                    int i = _offsets[k];
+
+                    if ((_names[i] == name.Length) && name.SequenceEqual(_names.AsSpan(i + 1, name.Length)))
+                        return true;
+                }
+
+                return false;
+            }
+
+            #endregion
+
+            #region properties
+
+            public int Count
+            { get { return _count; } }
+
+            #endregion
+        }
