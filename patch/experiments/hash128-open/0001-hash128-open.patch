+        //the list sets keep a 128 bit hash of each domain instead of the string, in a table of 16 byte slots that is at most 75%
+        //full: about 21 bytes per domain against about 80 for the string in a HashSet. The hash is two FNV-1a lanes with different
+        //multipliers (the same multiplier with another basis is not independent). A listed hash equal to the hash of another name
+        //reports that name as listed: about 7e-33 per label looked up with 2.5 million entries. The bases are random per process,
+        //so the names that would collide change at every start and cannot be precomputed.
+        readonly static ulong _domainHashBasis1 = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8));
+        readonly static ulong _domainHashBasis2 = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8));
+
+        private static (ulong, ulong) GetDomainHash(string domain)
+        {
+            ulong hash1 = _domainHashBasis1;
+            ulong hash2 = _domainHashBasis2;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                {
+                    hash1 = (hash1 ^ c) * 1099511628211UL;
+                    hash2 = (hash2 ^ c) * 11400714819323198485UL;
+                }
+            }
+
+            //the low bit of the first lane is the parity of the characters, which the second lane repeats, so it is used to mark a
+            //slot as taken: a taken slot never has a zero first word
+            return (hash1 | 1UL, hash2);
+        }
+
+        private sealed class DomainHashSet
+        {
+            public static readonly DomainHashSet Empty = new DomainHashSet(new Queue<(ulong, ulong)>());
+
+            readonly ulong[] _slots; //two words per slot: the first word is zero when the slot is free
+            readonly int _capacity;
+
+            public DomainHashSet(Queue<(ulong, ulong)> hashes)
+            {
+                _capacity = (int)(hashes.Count / 0.75) + 1;
+                _slots = new ulong[2 * _capacity];
+
+                foreach ((ulong hash1, ulong hash2) in hashes)
+                {
+                    int i = GetSlot(hash1);
+
+                    while ((_slots[2 * i] != 0) && ((_slots[2 * i] != hash1) || (_slots[2 * i + 1] != hash2)))
+                    {
+                        if (++i == _capacity)
+                            i = 0;
+                    }
+
+                    _slots[2 * i] = hash1;
+                    _slots[2 * i + 1] = hash2;
+                }
+            }
+
+            private int GetSlot(ulong hash1)
+            {
+                return (int)(((hash1 >> 32) * (uint)_capacity) >> 32);
+            }
+
+            public bool Contains((ulong, ulong) hash)
+            {
+                int i = GetSlot(hash.Item1);
+
+                while (_slots[2 * i] != 0)
+                {
+                    if ((_slots[2 * i] == hash.Item1) && (_slots[2 * i + 1] == hash.Item2))
+                        return true;
+
+                    if (++i == _capacity)
+                        i = 0;
+                }
+
+                return false;
+            }
+        }
+
+        private static bool IsZoneFound(DomainHashSet domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (domains.Contains(GetDomainHash(domain)))
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
