+        //exact set of domains as the parser stores them (the plain block list lowercases; the
+        //adblock parser does not). The names are UTF-8 bytes in one buffer, each prefixed by its
+        //length, and a HashSet<int> holds their offsets, so a name costs its bytes plus 16 bytes
+        //instead of a string object and a set entry. Add() only before Sort(); Contains() only
+        //after. Names over 255 characters or 255 UTF-8 bytes are not stored: both parsers reject
+        //them through IsDomainNameValid, so no entry is lost.
+        sealed class DomainSet : IEqualityComparer<int>, IAlternateEqualityComparer<ReadOnlySpan<byte>, int>
+        {
+            #region variables
+
+            byte[] _buffer;
+            int _length;
+            int _count;
+            int _sortedCount;
+            HashSet<int>? _set;
+            HashSet<int>.AlternateLookup<ReadOnlySpan<byte>> _lookup;
+
+            #endregion
+
+            #region constructor
+
+            public DomainSet(int capacity)
+            {
+                _buffer = new byte[Math.Max(capacity, 1024)];
+            }
+
+            #endregion
+
+            #region private
+
+            private ReadOnlySpan<byte> GetName(int offset)
+            {
+                return _buffer.AsSpan(offset + 1, _buffer[offset]);
+            }
+
+            private static int GetHash(ReadOnlySpan<byte> name)
+            {
+                HashCode hash = new HashCode();
+                hash.AddBytes(name);
+                return hash.ToHashCode();
+            }
+
+            bool IEqualityComparer<int>.Equals(int x, int y)
+            {
+                return GetName(x).SequenceEqual(GetName(y));
+            }
+
+            int IEqualityComparer<int>.GetHashCode(int offset)
+            {
+                return GetHash(GetName(offset));
+            }
+
+            bool IAlternateEqualityComparer<ReadOnlySpan<byte>, int>.Equals(ReadOnlySpan<byte> alternate, int offset)
+            {
+                return alternate.SequenceEqual(GetName(offset));
+            }
+
+            int IAlternateEqualityComparer<ReadOnlySpan<byte>, int>.GetHashCode(ReadOnlySpan<byte> alternate)
+            {
+                return GetHash(alternate);
+            }
+
+            int IAlternateEqualityComparer<ReadOnlySpan<byte>, int>.Create(ReadOnlySpan<byte> alternate)
+            {
+                throw new NotSupportedException();
+            }
+
+            #endregion
+
+            #region public
+
+            public void Add(string domain)
+            {
+                if (_set is not null)
+                    throw new InvalidOperationException("Add() must be called before Sort().");
+
+                if (domain.Length > 255)
+                    return; //invalid domain name
+
+                Span<byte> name = stackalloc byte[255];
+                if (!Encoding.UTF8.TryGetBytes(domain, name, out int nameLength))
+                    return; //invalid domain name
+
+                if (_length + nameLength + 1 > _buffer.Length)
+                    Array.Resize(ref _buffer, Math.Max(_buffer.Length * 2, _length + nameLength + 1));
+
+                _buffer[_length] = (byte)nameLength;
+                name.Slice(0, nameLength).CopyTo(_buffer.AsSpan(_length + 1));
+                _length += nameLength + 1;
+                _count++;
+            }
+
+            public void Sort()
+            {
+                HashSet<int> set = new HashSet<int>(_count, this);
+
+                for (int offset = 0; offset < _length; offset += _buffer[offset] + 1)
+                    set.Add(offset);
+
+                _sortedCount = set.Count;
+                _lookup = set.GetAlternateLookup<ReadOnlySpan<byte>>();
+                _set = set;
+            }
+
+            public bool Contains(string domain)
+            {
+                if (domain.Length > 255)
+                    return false; //invalid domain name
+
+                if (_count == 0)
+                    return false;
+
+                if (_set is null)
+                    throw new InvalidOperationException("Contains() before Sort()");
+
+                Span<byte> name = stackalloc byte[255];
+                if (!Encoding.UTF8.TryGetBytes(domain, name, out int nameLength))
+                    return false; //invalid domain name
+
+                return _lookup.Contains(name.Slice(0, nameLength));
+            }
+
+            #endregion
+
+            #region properties
+
+            public int RawCount
+            { get { return _count; } }
+
+            #endregion
+        }
