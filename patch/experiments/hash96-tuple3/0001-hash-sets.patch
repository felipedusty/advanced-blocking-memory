+        //the list sets keep a 96 bit hash of each domain instead of the string: 20 bytes per domain in the set against about
+        //80 for the string and its entry. The hash is the 64 bits of a FNV-1a lane and the top 32 bits of a second lane with
+        //another multiplier. A listed hash equal to the hash of another name reports that name as listed: about 1e-22 per
+        //query with 2.5 million entries. The bases are random per process, so the names that would collide change at every
+        //start and cannot be precomputed.
+        readonly static ulong _domainHashBasis1 = (ulong)Random.Shared.NextInt64() | 1UL;
+        readonly static ulong _domainHashBasis2 = (ulong)Random.Shared.NextInt64() | 1UL;
+
+        private static (uint, uint, uint) GetDomainHash(string domain)
+        {
+            ulong hash1 = _domainHashBasis1;
+            ulong hash2 = _domainHashBasis2;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                {
+                    hash1 = (hash1 ^ c) * 1099511628211UL;
+                    hash2 = (hash2 ^ c) * 11400714819323198485UL;
+                }
+            }
+
+            return ((uint)(hash1 >> 32), (uint)hash1, (uint)(hash2 >> 32));
+        }
+
+        private static bool IsZoneFound(HashSet<(uint, uint, uint)> domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (domains.Contains(GetDomainHash(domain)))
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
