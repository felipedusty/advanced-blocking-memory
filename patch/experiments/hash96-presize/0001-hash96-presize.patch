+        //the list sets keep a 96 bit hash of each domain instead of the string, in a sorted list: 12 bytes per domain against about 80
+        //for the string and its set entry. The hash is a 64 bit FNV-1a and the top 32 bits of a second recurrence with another
+        //multiplier. A listed hash equal to the hash of another name reports that name as listed: entries/2^96 per label looked up,
+        //summed over the lists consulted, about 3e-23 with 2.5 million entries (about 1e-22 per query of three labels). The bases
+        //are random per process, so the names that collide change at every start and cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+        readonly static ulong _domainHashBasis2 = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        [StructLayout(LayoutKind.Sequential, Pack = 4)]
+        readonly struct DomainHash : IComparable<DomainHash>
+        {
+            readonly ulong _high;
+            readonly uint _low;
+
+            public DomainHash(ulong high, uint low)
+            {
+                _high = high;
+                _low = low;
+            }
+
+            public int CompareTo(DomainHash other)
+            {
+                int result = _high.CompareTo(other._high);
+
+                return result != 0 ? result : _low.CompareTo(other._low);
+            }
+        }
+
+        private static DomainHash GetDomainHash(string domain)
+        {
+            ulong hash1 = _domainHashBasis;
+            ulong hash2 = _domainHashBasis2;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                {
+                    hash1 = (hash1 ^ c) * 1099511628211UL;
+                    hash2 = (hash2 ^ c) * 0x9E3779B97F4A7C15UL;
+                }
+            }
+
+            return new DomainHash(hash1, (uint)(hash2 >> 32));
+        }
+
+        private static bool IsZoneFound(List<DomainHash> domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (CollectionsMarshal.AsSpan(domains).BinarySearch(GetDomainHash(domain)) >= 0)
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
