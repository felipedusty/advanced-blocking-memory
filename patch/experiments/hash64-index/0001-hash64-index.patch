+        //the list sets keep a 64 bit FNV-1a hash of each domain instead of the string, in a sorted array: 8 bytes per domain against
+        //about 80 for the string and its set entry, plus an index of the first position of each value of the top bits of the hash, so a
+        //lookup searches about 4 hashes. A listed hash equal to the hash of another name reports that name as listed: entries/2^64 per
+        //label looked up, summed over the lists consulted, about 1.4e-13 with 2.5 million entries (about 4e-13 per query of three
+        //labels). The basis is random per process, so the names that collide change at every start and cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        private static ulong GetDomainHash(string domain)
+        {
+            ulong hash = _domainHashBasis;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                    hash = (hash ^ c) * 1099511628211UL;
+            }
+
+            return hash;
+        }
+
+        class HashList
+        {
+            ulong[] _hashes = [];
+            uint[] _index = [0, 0, 0];
+            int _count;
+            int _shift = 63;
+
+            public int Count
+            {
+                get { return _count; }
+            }
+
+            public void Reserve(int capacity)
+            {
+                Array.Resize(ref _hashes, capacity);
+            }
+
+            public void Add(string domain)
+            {
+                if (_count == _hashes.Length)
+                    Array.Resize(ref _hashes, Math.Max(16, _count * 2));
+
+                _hashes[_count++] = GetDomainHash(domain);
+            }
+
+            public void Sort()
+            {
+                Array.Sort(_hashes, 0, _count);
+
+                //about 4 hashes per value of the top bits
+                int bits = Math.Max(1, 32 - System.Numerics.BitOperations.LeadingZeroCount((uint)(_count / 4)));
+                uint[] index = new uint[(1 << bits) + 1];
+                int position = 0;
+
+                for (int prefix = 0; prefix < index.Length; prefix++)
+                {
+                    while ((position < _count) && ((_hashes[position] >> (64 - bits)) < (ulong)prefix))
+                        position++;
+
+                    index[prefix] = (uint)position;
+                }
+
+                _index = index;
+                _shift = 64 - bits;
+            }
+
+            public bool Contains(string domain)
+            {
+                ulong hash = GetDomainHash(domain);
+                int prefix = (int)(hash >> _shift);
+                int start = (int)_index[prefix];
+
+                return _hashes.AsSpan(start, (int)_index[prefix + 1] - start).BinarySearch(hash) >= 0;
+            }
+        }
+
+        private static bool IsZoneFound(HashList domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (domains.Contains(domain))
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
