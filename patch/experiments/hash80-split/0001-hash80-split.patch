+        //the list sets keep an 80 bit hash of each domain instead of the string: 10 bytes per domain against about 80 for the string and
+        //its set entry. The hash is a 64 bit FNV-1a and 16 bits of a second recurrence with another multiplier. The first 64 bits
+        //are kept sorted in one array and the other 16 in a second one, so a lookup searches 8 byte keys and reads the second array
+        //only for a match. A listed hash equal to the hash of another name reports that name as listed: entries/2^80 per label looked
+        //up, summed over the lists consulted, about 2e-18 with 2.5 million entries (about 6e-18 per query of three labels). The bases
+        //are random per process, so the names that collide change at every start and cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+        readonly static ulong _domainHashBasis2 = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        private static ulong GetDomainHash(string domain, out ushort hashLow)
+        {
+            ulong hash1 = _domainHashBasis;
+            ulong hash2 = _domainHashBasis2;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                {
+                    hash1 = (hash1 ^ c) * 1099511628211UL;
+                    hash2 = (hash2 ^ c) * 0x9E3779B97F4A7C15UL;
+                }
+            }
+
+            hashLow = (ushort)(hash2 >> 48);
+            return hash1;
+        }
+
+        class HashList
+        {
+            ulong[] _high;
+            ushort[] _low;
+            int _count;
+
+            public HashList()
+            {
+                _high = [];
+                _low = [];
+            }
+
+            public void Reserve(int capacity)
+            {
+                Array.Resize(ref _high, capacity);
+                Array.Resize(ref _low, capacity);
+            }
+
+            public int Count
+            {
+                get { return _count; }
+            }
+
+            public void Add(string domain)
+            {
+                if (_count == _high.Length)
+                {
+                    Array.Resize(ref _high, Math.Max(16, _count * 2));
+                    Array.Resize(ref _low, _high.Length);
+                }
+
+                _high[_count] = GetDomainHash(domain, out _low[_count]);
+                _count++;
+            }
+
+            public void Sort()
+            {
+                Array.Sort(_high, _low, 0, _count);
+            }
+
+            public bool Contains(string domain)
+            {
+                ulong high = GetDomainHash(domain, out ushort low);
+                int i = _high.AsSpan(0, _count).BinarySearch(high);
+                if (i < 0)
+                    return false;
+
+                while ((i > 0) && (_high[i - 1] == high))
+                    i--;
+
+                for (; (i < _count) && (_high[i] == high); i++)
+                {
+                    if (_low[i] == low)
+                        return true;
+                }
+
+                return false;
+            }
+        }
+
+        private static bool IsZoneFound(HashList domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (domains.Contains(domain))
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
