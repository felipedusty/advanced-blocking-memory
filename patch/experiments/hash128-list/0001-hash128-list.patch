+        //the list sets keep a 64 bit FNV-1a hash of each domain instead of the string, in a sorted array: 8 bytes per domain
+        //against about 80 for the string and its set entry. A listed hash equal to the hash of another name reports that name as
+        //listed: entries/2^64 per label looked up, summed over the lists consulted, about 1.4e-13 with 2.5 million entries (about
+        //4e-13 per query of three labels). The basis is random per process, so the names that collide change at every start and
+        //cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+        readonly static ulong _domainHashBasis2 = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        private static UInt128 GetDomainHash(string domain)
+        {
+            ulong hash1 = _domainHashBasis;
+            ulong hash2 = _domainHashBasis2;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                {
+                    hash1 = (hash1 ^ c) * 1099511628211UL;
+                    hash2 = (hash2 ^ c) * 0x9E3779B97F4A7C15UL;
+                }
+            }
+
+            return new UInt128(hash1, hash2);
+        }
+
+        private static bool IsZoneFound(List<UInt128> domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (CollectionsMarshal.AsSpan(domains).BinarySearch(GetDomainHash(domain)) >= 0)
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
+        //the number of lines is an upper bound of the number of domains of a list file, so the hashes are collected in a list that
+        //is allocated once instead of being grown by doubling
+        private static int CountLines(string filePath)
+        {
+            using (FileStream fS = new FileStream(filePath, FileMode.Open, FileAccess.Read))
+            {
+                byte[] buffer = new byte[65536];
+                int lines = 1;
+                int bytesRead;
+
+                while ((bytesRead = fS.Read(buffer, 0, buffer.Length)) > 0)
+                    lines += buffer.AsSpan(0, bytesRead).Count((byte)'\n');
+
+                return lines;
+            }
+        }
+
