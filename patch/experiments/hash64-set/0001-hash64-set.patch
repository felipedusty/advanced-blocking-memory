+        //the list sets keep a 64 bit FNV-1a hash of each domain instead of the string: about 20 bytes per domain against about 80.
+        //A listed hash equal to the hash of another name reports that name as listed: entries/2^64 per label looked up, summed over
+        //the lists consulted, about 1.4e-13 with 2.5 million entries (about 4e-13 per query of three labels). The basis is random
+        //per process, so the names that collide change at every start and cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        private static ulong GetDomainHash(string domain)
+        {
+            ulong hash = _domainHashBasis;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                    hash = (hash ^ c) * 1099511628211UL;
+            }
+
+            return hash;
+        }
+
+        private static bool IsZoneFound(HashSet<ulong> domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (domains.Contains(GetDomainHash(domain)))
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
