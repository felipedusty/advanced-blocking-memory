+        //the list sets keep a 64 bit FNV-1a hash of each domain instead of the string, in a sorted array: 8 bytes per domain
+        //against about 80 for the string and its set entry. A listed hash equal to the hash of another name reports that name as
+        //listed: entries/2^64 per label looked up, summed over the lists consulted, about 1.4e-13 with 2.5 million entries (about
+        //4e-13 per query of three labels). The basis is random per process, so the names that collide change at every start and
+        //cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        private static ulong GetDomainHash(string domain)
+        {
+            ulong hash = _domainHashBasis;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                    hash = (hash ^ c) * 1099511628211UL;
+            }
+
+            return hash;
+        }
+
+        private static bool IsZoneFound(ulong[][] domains, string domain, out string? foundZone)
+        {
+            if (domains.Length > 0)
+            {
+                do
+                {
+                    ulong hash = GetDomainHash(domain);
+
+                    if (domains[(int)(hash >> 56)].AsSpan().BinarySearch(hash) >= 0)
+                    {
+                        foundZone = domain;
+                        return true;
+                    }
+
+                    domain = GetParentZone(domain)!;
+                }
+                while (domain is not null);
+            }
+
+            foundZone = null;
+            return false;
+        }
+
+        //collects the hashes of a list in 256 small lists by the top 8 bits of the hash and turns each into a sorted array, so no
+        //large buffer is grown by doubling while the list loads and a lookup searches 1/256 of the list
+        class HashBuckets
+        {
+            readonly List<ulong>?[] _lists = new List<ulong>?[256];
+            int _count;
+
+            public int Count
+            {
+                get { return _count; }
+            }
+
+            public void Add(ulong hash)
+            {
+                (_lists[(int)(hash >> 56)] ??= new List<ulong>()).Add(hash);
+                _count++;
+            }
+
+            public ulong[][] ToSortedArrays()
+            {
+                ulong[][] buckets = new ulong[_lists.Length][];
+
+                for (int i = 0; i < buckets.Length; i++)
+                {
+                    ulong[] bucket = _lists[i]?.ToArray() ?? [];
+                    Array.Sort(bucket);
+
+                    buckets[i] = bucket;
+                    _lists[i] = null;
+                }
+
+                return buckets;
+            }
+        }
+
