+        //the list sets keep a 64 bit FNV-1a hash of each domain instead of the string, in a sorted array: 8 bytes per domain
+        //against about 80 for the string and its set entry. A listed hash equal to the hash of another name reports that name as
+        //listed: entries/2^64 per label looked up, summed over the lists consulted, about 1.4e-13 with 2.5 million entries (about
+        //4e-13 per query of three labels). The basis is random per process, so the names that collide change at every start and
+        //cannot be precomputed.
+        readonly static ulong _domainHashBasis = BitConverter.ToUInt64(System.Security.Cryptography.RandomNumberGenerator.GetBytes(8)) | 1UL;
+
+        private static ulong GetDomainHash(string domain)
+        {
+            ulong hash = _domainHashBasis;
+
+            unchecked
+            {
+                foreach (char c in domain)
+                    hash = (hash ^ c) * 1099511628211UL;
+            }
+
+            return hash;
+        }
+
+        //the sorted hashes of a list and the position of the first hash of each value of the top bits: the hashes are spread evenly,
+        //so a lookup searches about 8 of them instead of the whole list
+        sealed class HashIndex
+        {
+            readonly List<ulong> _hashes;
+            readonly uint[] _starts;
+            readonly int _shift;
+
+            public HashIndex(List<ulong> hashes)
+            {
+                Span<ulong> sorted = CollectionsMarshal.AsSpan(hashes);
+                sorted.Sort();
+
+                int bits = Math.Max(1, 32 - System.Numerics.BitOperations.LeadingZeroCount((uint)(sorted.Length / 8)));
+
+                _hashes = hashes;
+                _starts = new uint[(1 << bits) + 1];
+                _shift = 64 - bits;
+
+                foreach (ulong hash in sorted)
+                    _starts[(int)(hash >> _shift) + 1]++;
+
+                for (int i = 1; i < _starts.Length; i++)
+                    _starts[i] += _starts[i - 1];
+            }
+
+            public bool Contains(ulong hash)
+            {
+                int bucket = (int)(hash >> _shift);
+                int start = (int)_starts[bucket];
+
+                return CollectionsMarshal.AsSpan(_hashes).Slice(start, (int)_starts[bucket + 1] - start).BinarySearch(hash) >= 0;
+            }
+        }
+
+        private static bool IsZoneFound(HashIndex domains, string domain, out string? foundZone)
+        {
+            do
+            {
+                if (domains.Contains(GetDomainHash(domain)))
+                {
+                    foundZone = domain;
+                    return true;
+                }
+
+                domain = GetParentZone(domain)!;
+            }
+            while (domain is not null);
+
+            foundZone = null;
+            return false;
+        }
+
